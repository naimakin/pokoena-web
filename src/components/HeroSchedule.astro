---
// Illustrative update-period view: baseline (outline) vs this update (filled).
// Weeks 0–12. One logic change is held for approval.
const rows = [
  { name: 'Site mobilisation', owner: 'Main contractor', base: [0, 2], upd: [0, 2], state: 'done' },
  { name: 'Excavation & shoring', owner: 'Earthworks sub.', base: [1, 4], upd: [1, 5], state: 'done' },
  { name: 'Raft foundation', owner: 'Structural sub.', base: [4, 6], upd: [5, 7], state: 'done' },
  { name: 'Superstructure L1–L8', owner: 'Structural sub.', base: [6, 10], upd: [7, 11], state: 'done' },
  { name: 'MEP rough-in', owner: 'MEP sub.', base: [8, 11], upd: [8, 11], state: 'flag' },
  { name: 'Façade installation', owner: 'Façade sub.', base: [9, 12], upd: [10, 12], state: 'open' },
];
const weeks = 12;
const dataDate = 5.5;
const pct = (n: number) => `${(n / weeks) * 100}%`;
const stateLabel: Record<string, string> = { done: 'Submitted', flag: 'Needs approval', open: 'In progress' };
---
<figure class="sched" aria-labelledby="sched-cap">
  <div class="sched__bar">
    <span class="sched__period">Update period 7 <em>closes in 2 days</em></span>
    <span class="sched__count"><strong>4 of 6</strong> scopes submitted</span>
  </div>

  <div class="sched__grid" role="table" aria-label="Schedule update: baseline versus current update">
    <div class="sched__row sched__row--head" role="row">
      <span role="columnheader">Activity</span>
      <span role="columnheader" class="sched__owner">Scope owner</span>
      <span role="columnheader" class="sched__axis">
        {Array.from({ length: weeks / 2 }, (_, i) => <i>W{i * 2 + 1}</i>)}
      </span>
    </div>
    {rows.map((r, i) => (
      <div class={`sched__row is-${r.state}`} role="row" style={`--i:${i}`}>
        <span role="cell" class="sched__name">{r.name}</span>
        <span role="cell" class="sched__owner">{r.owner}</span>
        <span role="cell" class="sched__track" aria-label={`${stateLabel[r.state]}`}>
          <span class="sched__dd" style={`left:${pct(dataDate)}`} aria-hidden="true">{i === rows.length - 1 && <b>Data date</b>}</span>
          <span class="sched__base" style={`left:${pct(r.base[0])};width:${pct(r.base[1] - r.base[0])}`}></span>
          <span
            class="sched__upd"
            style={`--from-left:${pct(r.base[0])};--from-w:${pct(r.base[1] - r.base[0])};--to-left:${pct(r.upd[0])};--to-w:${pct(r.upd[1] - r.upd[0])}`}
          ></span>
        </span>
      </div>
    ))}
  </div>

  <figcaption id="sched-cap" class="sched__flag">
    <span class="sched__flagmark" aria-hidden="true"></span>
    <span><strong>MEP rough-in:</strong> predecessor link changed from FS to SS +2w. The change is held until the planning admin approves it, so the one-week slip on the superstructure can't be hidden.</span>
  </figcaption>

  <p class="sched__legend" aria-hidden="true">
    <span><i class="k k--base"></i>Baseline</span>
    <span><i class="k k--upd"></i>This update</span>
  </p>
</figure>

<style>
  .sched {
    margin: 0; background: #fff; color: var(--text);
    border-radius: var(--radius); overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0,0,0,.55);
    font-size: .875rem;
  }
  .sched__bar {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem;
    padding: .85rem 1.25rem; border-bottom: 1px solid var(--line); background: var(--paper);
  }
  .sched__period { font-weight: 650; color: var(--navy); }
  .sched__period em { font-style: normal; font-weight: 450; color: var(--muted); margin-left: .5rem; }
  .sched__count { color: var(--muted); }
  .sched__count strong { color: var(--navy); }

  .sched__grid { position: relative; padding: .5rem 1.25rem 1rem; --cols: minmax(9rem, 1.3fr) minmax(7rem, .9fr) 3fr; }
  .sched__row { display: grid; grid-template-columns: var(--cols); align-items: center; gap: 1rem; min-height: 2.6rem; border-bottom: 1px solid #eef0f6; }
  .sched__row:last-of-type { border-bottom: 0; }
  .sched__row--head { min-height: 2rem; color: var(--muted); font-size: .78rem; font-weight: 550; }
  .sched__name { font-weight: 560; color: var(--navy); font-stretch: 92%; }
  .sched__owner { color: var(--muted); font-stretch: 88%; }
  .sched__axis { display: grid; grid-template-columns: repeat(6, 1fr); }
  .sched__axis i { font-style: normal; }

  .sched__track { position: relative; height: 1.25rem; }
  .sched__base, .sched__upd { position: absolute; top: 50%; border-radius: 3px; }
  .sched__base { height: 1.1rem; transform: translateY(-50%); border: 1.5px dashed #b9bdd2; }
  .sched__upd {
    height: .6rem; transform: translateY(-50%); background: var(--violet);
    left: var(--to-left); width: var(--to-w);
    animation: slip 1.1s cubic-bezier(.6,0,.2,1) both;
    animation-delay: calc(.35s + var(--i) * .09s);
  }
  .is-open .sched__upd { background: repeating-linear-gradient(135deg, var(--violet-soft) 0 5px, #b7aee8 5px 10px); }
  .is-flag .sched__upd { background: var(--flag); box-shadow: 0 0 0 3px rgba(242,178,51,.3); }
  .is-flag .sched__name::after {
    content: ''; display: inline-block; width: .55rem; height: .55rem; margin-left: .45rem;
    border-radius: 50%; background: var(--flag); vertical-align: middle;
  }
  @keyframes slip {
    from { left: var(--from-left); width: var(--from-w); opacity: .35; }
    to { left: var(--to-left); width: var(--to-w); opacity: 1; }
  }

  .sched__dd { position: absolute; top: -.75rem; bottom: -.75rem; width: 0; border-left: 1.5px solid var(--navy); z-index: 1; }
  .sched__dd b {
    position: absolute; bottom: -1.2rem; left: -1.6rem; white-space: nowrap;
    font-size: .7rem; font-weight: 600; color: var(--navy);
  }
  .sched__grid { padding-bottom: 1.6rem; }

  .sched__flag {
    display: flex; gap: .75rem; align-items: flex-start;
    margin: 0 1.25rem; padding: .85rem 1rem; border-radius: var(--radius-sm);
    background: #fff7e6; border: 1px solid #f4d48f; color: #4a3a12; line-height: 1.45;
    animation: appear .5s ease-out both; animation-delay: 1.9s;
  }
  .sched__flagmark { flex: none; width: .7rem; height: .7rem; margin-top: .35rem; border-radius: 50%; background: var(--flag); }
  @keyframes appear { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .sched__legend { display: flex; gap: 1.25rem; padding: .9rem 1.25rem 1.1rem; color: var(--muted); font-size: .78rem; }
  .sched__legend span { display: inline-flex; align-items: center; gap: .45rem; }
  .k { display: inline-block; width: 1.4rem; height: .6rem; border-radius: 2px; }
  .k--base { border: 1.5px dashed #b9bdd2; height: .8rem; }
  .k--upd { background: var(--violet); }

  @media (max-width: 640px) {
    .sched__grid { --cols: minmax(7.5rem, 1fr) 1.6fr; }
    .sched__owner { display: none; }
    .sched__axis i:nth-child(even) { visibility: hidden; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sched__upd, .sched__flag { animation: none; }
  }
</style>
