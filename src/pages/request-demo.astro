---
import Base from '../layouts/Base.astro';
---
<Base
  title="Request a demo | POKO"
  description="See POKO running one full update period on your own Primavera P6 schedule."
>
  <section class="demo">
    <div class="wrap demo__inner">
      <div class="demo__copy">
        <h1>Request a demo</h1>
        <p class="lede">We'll walk you through one full update period, from opening it to merging the result back into P6. It takes about 45 minutes.</p>
        <h2>What to expect</h2>
        <ul>
          <li>We reply within one working day to find a time.</li>
          <li>If you like, share a recent P6 schedule and we'll run the demo on your own activities.</li>
          <li>No commitment and no sales sequence afterwards.</li>
        </ul>
        <p class="demo__mail">Prefer email? Write to <a href="mailto:nakn@pokoena.com">nakn@pokoena.com</a>.</p>
      </div>

      <form class="form" id="demo-form" method="post" action="/api/demo" novalidate>
        <div class="form__row">
          <label for="name">Full name</label>
          <input id="name" name="name" autocomplete="name" required maxlength="120" />
        </div>
        <div class="form__row">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
        <div class="form__grid">
          <div class="form__row">
            <label for="company">Company</label>
            <input id="company" name="company" autocomplete="organization" required maxlength="160" />
          </div>
          <div class="form__row">
            <label for="role">Your role</label>
            <input id="role" name="role" autocomplete="organization-title" maxlength="120" placeholder="Planning manager" />
          </div>
        </div>
        <div class="form__row">
          <label for="org_type">Your organisation is a</label>
          <select id="org_type" name="org_type">
            <option value="">Choose one</option>
            <option>Owner or employer</option>
            <option>Main contractor</option>
            <option>Project management consultant</option>
            <option>Subcontractor</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form__row">
          <label for="message">What would you like to see? <span>Optional</span></label>
          <textarea id="message" name="message" rows="4" maxlength="3000"></textarea>
        </div>
        <div class="form__hp" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn--primary">Request a demo</button>
        <p class="form__status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('demo-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'form__status';
      const missing = ['name', 'email', 'company'].filter((n) => !(form.elements.namedItem(n) as HTMLInputElement).value.trim());
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      if (missing.length) {
        status.textContent = 'Fill in your name, work email and company to send the request.';
        status.classList.add('is-error');
        (form.elements.namedItem(missing[0]) as HTMLInputElement).focus();
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = 'Enter a valid email address, for example name@company.com.';
        status.classList.add('is-error');
        (form.elements.namedItem('email') as HTMLInputElement).focus();
        return;
      }
      const button = form.querySelector('button') as HTMLButtonElement;
      button.disabled = true;
      button.textContent = 'Sending request…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'request failed');
        form.reset();
        status.textContent = "Request sent. We'll reply to your email within one working day.";
        status.classList.add('is-ok');
      } catch (err) {
        status.textContent = 'The request could not be sent. Try again, or email nakn@pokoena.com directly.';
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
        button.textContent = 'Request a demo';
      }
    });
  }
</script>

<style>
  .demo { padding-block: clamp(3rem, 7vw, 5.5rem); background: var(--paper); }
  .demo__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .demo h1 { font-size: clamp(2.2rem, 4.6vw, 3.4rem); }
  .demo .lede { margin-top: 1.25rem; }
  .demo h2 { font-size: 1.15rem; font-stretch: 100%; margin-top: 2.5rem; }
  .demo ul { margin: 1rem 0 0; padding-left: 1.2rem; display: grid; gap: .5rem; color: var(--muted); }
  .demo__mail { margin-top: 2rem; color: var(--muted); }
  @media (max-width: 860px) { .demo__inner { grid-template-columns: 1fr; } }

  .form { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 2.25rem); display: grid; gap: 1.1rem; }
  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  @media (max-width: 520px) { .form__grid { grid-template-columns: 1fr; } }
  .form__row { display: grid; gap: .4rem; }
  .form label { font-weight: 600; font-size: .95rem; color: var(--navy); }
  .form label span { font-weight: 450; color: var(--muted); margin-left: .35rem; }
  .form input, .form select, .form textarea {
    font: inherit; font-size: 1rem; padding: .7rem .85rem; border: 1px solid #c6cadb; border-radius: var(--radius-sm);
    background: #fff; color: var(--text); width: 100%;
  }
  .form input::placeholder { color: #9a9eb5; }
  .form input:focus, .form select:focus, .form textarea:focus { outline: 2px solid var(--violet); outline-offset: 0; border-color: var(--violet); }
  .form textarea { resize: vertical; }
  .form .btn { justify-self: start; margin-top: .4rem; }
  .form .btn:disabled { opacity: .7; cursor: progress; }
  .form__hp { position: absolute; left: -9999px; }
  .form__status:empty { display: none; }
  .form__status { padding: .8rem 1rem; border-radius: var(--radius-sm); }
  .form__status.is-ok { background: #e8e5f8; color: var(--navy); }
  .form__status.is-error { background: #fbe4e4; color: #7a1c1c; }
</style>
