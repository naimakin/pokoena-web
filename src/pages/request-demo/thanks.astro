---
import Base from '../../layouts/Base.astro';
---
<Base title="Request sent | POKO" description="Your demo request has been sent.">
  <section class="wrap msg">
    <h1>Request sent</h1>
    <p class="lede">Thanks. We'll reply to your email within one working day to find a time for the demo.</p>
    <a href="/" class="btn btn--primary">Back to the homepage</a>
  </section>
</Base>

<style>
  .msg { padding-block: clamp(4rem, 12vw, 8rem); }
  .msg .lede { margin: 1.25rem 0 2rem; }
</style>
