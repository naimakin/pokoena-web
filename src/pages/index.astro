---
import Base from '../layouts/Base.astro';
import HeroSchedule from '../components/HeroSchedule.astro';
import SCurve from '../components/SCurve.astro';
import CtaBand from '../components/CtaBand.astro';

const problems = [
  {
    title: 'Too many hands in one file',
    text: 'On a project with dozens of subcontractors, engineers and consultants, progress arrives by email and spreadsheet and gets retyped into the schedule by one overloaded planner. Errors creep in and nobody can tell whose input is whose.',
  },
  {
    title: 'Changes hide in the logic',
    text: 'A shortened lag or a relationship switched from finish-to-start to start-to-start can absorb weeks of delay without a single date looking wrong. POKO compares every update with the previous one and lists each logic change, so none of them go unnoticed.',
  },
  {
    title: 'Analysis comes too late',
    text: "By the time progress is collected, checked and analysed, the period is half over. Owners and main contractors end up reacting to last month's picture.",
  },
];

const steps = [
  { title: 'Open the update period', text: 'A planner imports the latest schedule from P6 and sets a deadline.' },
  { title: 'Invite stakeholders', text: 'Everyone gets an email. Subcontractors see only their own scope, set by WBS or activity code.' },
  { title: 'Enter progress', text: 'Actual start and finish, percent complete, remaining duration and notes, entered where the work is done.' },
  { title: 'Approve progress', text: 'Each entry is a proposal until a company admin or project manager approves it.' },
  { title: 'Analyse', text: 'S-curve and earned value update as soon as progress is approved. Risk analysis runs in one click.' },
  { title: 'Back to P6', text: 'Export approved progress to P6 and reschedule there. The next import shows every logic change.' },
];

const capabilities = [
  { title: 'Scope-based access', text: 'Subcontractors see and update only their own activities, defined by WBS or activity code rules.' },
  { title: 'Progress approval', text: 'Progress entries wait in the approver\'s queue and reach the schedule only after a company admin or project manager approves them.' },
  { title: 'Progress audit trail', text: 'Every field change is recorded with who made it, when, and the old and new value, along with who approved or rejected each entry.' },
  { title: 'Logic change detection', text: 'Every link, lag and relationship type change between two updates, FS to SS included, listed for the planning team.' },
  { title: 'S-curve and earned value', text: 'Planned versus actual progress, SPI and CPI, updated as soon as progress is approved.' },
  { title: 'Risk analysis', text: 'Monte Carlo schedule risk analysis in one click, with P50 and P80 finish dates.' },
  { title: 'Reports and dashboards', text: 'Executive summary, monthly progress, delay analysis and schedule quality reports, or your own formats from the Report Builder. Print or save as PDF.' },
  { title: 'Optional AI assistant', text: 'Plain-language summaries and suggested follow-ups. Off by default and turned on only by your company admin.' },
];

const audiences = [
  { title: 'Owners and employers', text: 'A schedule you can trust each month, with every progress entry traceable to the person who made and approved it.' },
  { title: 'Main contractors', text: 'One update cycle for all subcontractors, without retyping their input into the schedule.' },
  { title: 'Project management consultants', text: 'Independent visibility of progress, logic changes, risk and forecast finish dates.' },
  { title: 'Planning and site engineers', text: 'Progress entered once, where the work happens, instead of passed along by email.' },
  { title: 'Subcontractors', text: 'A simple screen for their own scope instead of spreadsheets and email chains.' },
];
---
<Base
  title="POKO | Project Intelligence & Execution"
  description="POKO is a project planning and management platform for construction. Every stakeholder enters progress on their own scope, the planning team approves it, and S-curve and earned value update straight away. Schedule logic stays with your planning team in P6."
>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="hero__category">Project Intelligence &amp; Execution</p>
        <h1>Know exactly what changed in your schedule, and why.</h1>
        <p class="hero__lede">
          POKO is a project planning and management platform for construction. Every stakeholder enters progress on their
          own scope, the planning team approves it, and S-curve and earned value update straight away. Schedule logic
          stays with your planning team in P6.
        </p>
        <div class="hero__actions">
          <a href="/request-demo" class="btn btn--light">Request a demo</a>
          <a href="/platform" class="btn btn--ghost-light">See the platform</a>
        </div>
      </div>
      <div class="hero__visual">
        <HeroSchedule />
      </div>
    </div>
  </section>

  <section class="truth">
    <div class="wrap truth__inner">
      <div>
        <p class="truth__claim">POKO doesn't replace your scheduling software. It controls how your schedule gets updated.</p>
        <p class="truth__note">Starts with Primavera P6 schedules (.xer and .xml). Microsoft Project and Asta Powerproject import are on the way.</p>
      </div>
      <ol class="truth__flow" aria-label="How POKO works with your scheduling software">
        <li><strong>Your schedule</strong><span>imported from P6, the single source of truth</span></li>
        <li><strong>Progress in POKO</strong><span>entered by stakeholders, approved by your team</span></li>
        <li><strong>Back to P6</strong><span>exported, rescheduled, imported again</span></li>
      </ol>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <div class="section__head">
        <h2>Why schedule updates break down on large projects</h2>
        <p>The tools for planning are mature. The process for updating a shared schedule every month is not.</p>
      </div>
      <div class="problems">
        {problems.map((p) => (
          <article>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="wrap">
      <div class="section__head">
        <h2>One update period, start to finish</h2>
        <p>The same six steps every period, with every progress entry traceable to the person who made and approved it.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class={i === 3 ? 'is-flag' : ''}>
            <span class="steps__n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap caps">
      <div>
        <div class="section__head">
          <h2>Built for planning teams, not just planners</h2>
        </div>
        <dl class="caps__list">
          {capabilities.map((c) => (
            <div>
              <dt>{c.title}</dt>
              <dd>{c.text}</dd>
            </div>
          ))}
        </dl>
        <a href="/platform" class="caps__more">Explore the platform</a>
      </div>
      <div class="caps__visual">
        <SCurve />
      </div>
    </div>
  </section>

  <section class="section" id="who-its-for">
    <div class="wrap">
      <div class="section__head">
        <h2>Who uses POKO</h2>
        <p>Everyone in the update cycle works in the same place, each with the access their role needs.</p>
      </div>
      <ul class="who">
        {audiences.map((a) => (
          <li>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { background: var(--navy); color: rgba(255,255,255,.82); overflow: hidden; }
  .hero__inner {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 4rem);
    align-items: center; padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }
  .hero__category { color: var(--violet-soft); font-weight: 600; font-size: 1.05rem; font-stretch: 110%; margin-bottom: 1rem; }
  .hero h1 { color: #fff; font-size: clamp(2.4rem, 4.6vw, 3.75rem); }
  .hero__lede { margin-top: 1.5rem; font-size: 1.2rem; max-width: 34rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.25rem; }
  @media (max-width: 1000px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero h1 { max-width: 40rem; }
  }

  .truth { border-bottom: 1px solid var(--line); }
  .truth__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 2rem 4rem; align-items: center; padding-block: 3rem; }
  .truth__claim { font-size: clamp(1.3rem, 2.2vw, 1.6rem); font-weight: 600; font-stretch: 106%; color: var(--navy); line-height: 1.3; }
  .truth__note { margin-top: .75rem; color: var(--muted); font-size: .95rem; }
  .truth__flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .truth__flow li { position: relative; padding: 1rem 1.5rem 1rem 0; display: grid; gap: .2rem; }
  .truth__flow li:not(:last-child)::after {
    content: ''; position: absolute; right: .6rem; top: 1.55rem; width: .55rem; height: .55rem;
    border-top: 2px solid var(--violet); border-right: 2px solid var(--violet); transform: rotate(45deg);
  }
  .truth__flow strong { color: var(--navy); font-weight: 650; }
  .truth__flow span { color: var(--muted); font-size: .92rem; }
  @media (max-width: 860px) {
    .truth__inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .truth__flow { grid-template-columns: 1fr; }
    .truth__flow li { padding: .6rem 0 .6rem 1.4rem; border-left: 2px solid var(--line); }
    .truth__flow li::after { display: none; }
  }

  .problems { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 3rem); }
  .problems article { border-top: 3px solid var(--navy); padding-top: 1.25rem; }
  .problems p { margin-top: .75rem; color: var(--muted); }
  @media (max-width: 860px) { .problems { grid-template-columns: 1fr; } }

  .steps {
    list-style: none; margin: 0; padding: 0; counter-reset: s;
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 0;
  }
  .steps li { position: relative; padding: 0 1.25rem 0 0; }
  .steps li::before {
    content: ''; position: absolute; left: 2.25rem; right: 0; top: 1.1rem; height: 2px; background: var(--line);
  }
  .steps li:last-child::before { display: none; }
  .steps__n {
    position: relative; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border-radius: 50%; background: var(--navy); color: #fff; font-weight: 700; margin-bottom: 1.1rem;
  }
  .steps .is-flag .steps__n { background: var(--flag); color: var(--navy); }
  .steps h3 { font-size: 1.05rem; }
  .steps p { margin-top: .5rem; color: var(--muted); font-size: .95rem; }
  @media (max-width: 1000px) {
    .steps { grid-template-columns: 1fr 1fr 1fr; row-gap: 2.5rem; }
    .steps li:nth-child(3)::before { display: none; }
  }
  @media (max-width: 640px) {
    .steps { grid-template-columns: 1fr; row-gap: 0; }
    .steps li { padding: 0 0 2rem 3.25rem; }
    .steps__n { position: absolute; left: 0; top: 0; margin: 0; }
    .steps li::before, .steps li:nth-child(3)::before { display: block; left: 1.07rem; top: 2.25rem; bottom: 0; right: auto; width: 2px; height: auto; }
    .steps li:last-child::before { display: none; }
  }

  .caps { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .caps .section__head { margin-bottom: 2rem; }
  .caps__list { margin: 0; display: grid; gap: 1.4rem; }
  .caps__list div { padding-left: 1.1rem; border-left: 3px solid var(--violet); }
  .caps__list dt { font-weight: 650; color: var(--navy); font-size: 1.08rem; }
  .caps__list dd { margin: .25rem 0 0; color: var(--muted); }
  .caps__more { display: inline-block; margin-top: 2rem; font-weight: 650; }
  .caps__visual { position: sticky; top: 6rem; }
  @media (max-width: 900px) {
    .caps { grid-template-columns: 1fr; }
    .caps__visual { position: static; }
  }

  .who { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .who li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 1rem 3rem; padding: 1.6rem 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .who p { color: var(--muted); font-size: 1.1rem; }
  @media (max-width: 700px) { .who li { grid-template-columns: 1fr; gap: .4rem; } }
</style>
